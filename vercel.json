{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/schedule/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/schedule/tick",
      "schedule": "0 6 * * *"
    }
  ]
}
