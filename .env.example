# ConfigCat Management API (a.k.a. Public API) credentials.
#
# Get them from the ConfigCat dashboard: account menu (top right) ->
# "Public API credentials" -> add a new credential. You get a Basic auth
# user name and password pair. The password is shown once.
#
# SERVER-SIDE ONLY. Never prefix these with VITE_ - Vite copies every
# VITE_-prefixed variable into the public browser bundle, which would publish
# write access to the live game config to anyone who opens the page.
CONFIGCAT_API_USER=
CONFIGCAT_API_PASS=

# GitHub fine-grained PAT with Contents: read/write on this repo only.
# Used to commit config/*.json as the source of truth. Not needed until the
# write path lands.
GITHUB_TOKEN=
