{
  "name": "cliff-heroes-back-office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live-ops back office for Cliff Heroes: publish and schedule the game config from its design sheets.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:graph": "esbuild scripts/checkGraph.ts --bundle --platform=node --format=cjs --outfile=dist/check-graph.cjs --log-level=warning && node dist/check-graph.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
